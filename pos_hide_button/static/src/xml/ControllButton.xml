<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ControlButtonCustome" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='() => this.clickRefund()']" position="replace"> 
            <t t-if="has_refund">
                <button class="btn btn-secondary btn-lg py-5" t-on-click="() => this.clickRefund()">
                    <i class="fa fa-undo me-1" role="img" aria-label="Refund" title="Refund" />
                    Refunds
                </button>
            </t>
        </xpath>
        <xpath expr="//NoteButton[@class='buttonClass']" position="replace"> 
            <t t-if="has_customer_note">
                    <NoteButton
                    label.translate="Customer Note"
                    class="buttonClass"
                    icon="'fa fa-sticky-note'"/>            
            </t>
        </xpath>
        <xpath expr="//button[@t-on-click='() => this.onClickQuotation()']" position="replace">
            <t t-if="has_quotations">
                <button t-if="this.pos.cashier._role != 'minimal'" t-att-class="buttonClass" t-on-click="() => this.onClickQuotation()">
                    <i class="fa fa-link me-1" role="img" aria-label="Set Sale Order" title="Set Sale Order" /> Quotation/Order
                </button>
            </t>
        </xpath>
        <xpath expr="//button[@t-on-click='this.onCancelOrder']" position="replace"> 
            <t t-if="has_cancel">
                <button t-if="this.pos.cashier._role != 'minimal'" t-att-class="buttonClass" t-on-click="this.onCancelOrder">
                    <i class="fa fa-trash me-1" role="img" /> Cancel Order 
                </button>
            </t>
        </xpath>
        <xpath expr="//button[@t-on-click='() => this.clickPricelist()']" position="replace"> 
            <t t-if="has_pricelist">
                <button t-if="this.pos.cashier._role != 'minimal'" class="o_pricelist_button" t-att-class="buttonClass" t-on-click="() => this.clickPricelist()">
                    <i class="fa fa-th-list me-2" role="img" aria-label="Price list" title="Price list" />
                    <t t-if="currentOrder?.pricelist_id" t-esc="currentOrder.pricelist_id.display_name" />
                    <t t-else="">Pricelist</t>
                </button>
            </t>
        </xpath>
        <xpath expr="//button[@t-on-click='() => this.pos.onProductInfoClick(currentOrder.getSelectedOrderline().product_id.product_tmpl_id, currentOrder.getSelectedOrderline().product_id)']" position="replace"> 
            <t t-if="has_info">
                <button t-if="this.displayProductInfoBtn()" t-att-class="buttonClass" t-on-click="() => this.pos.onProductInfoClick(currentOrder.getSelectedOrderline().product_id.product_tmpl_id, currentOrder.getSelectedOrderline().product_id)">
                    <i class="fa fa-info-circle me-1" role="img" aria-label="Product Info" title="Product Info" /> Info
                </button>     
            </t>
        </xpath>

        <xpath expr="//button[@t-on-click='() => this.clickPromoCode()']" position="replace"> 
            <t t-if="has_enter_code">
                <button t-att-class="buttonClass"
                    t-on-click="() => this.clickPromoCode()">
                    <i class="fa fa-barcode me-1"/>Enter Code
                </button> 
            </t>
        </xpath>
        <xpath expr="//button[@t-on-click='() => this.clickRewards()']" position="replace"> 
            <t t-if="has_reward">
                <button class="control-button"
                    t-att-class="buttonClass"
                    t-attf-class="{{state.nbrRewards ? 'highlight' : 'disabled'}}"
                    t-on-click="() => this.clickRewards()">
                    <i class="fa fa-star me-1 text-favourite"/>Reward
                </button>
            </t>
        </xpath>
        <xpath expr="//button[@t-on-click='() => this.pos.resetPrograms()']" position="replace"> 
            <t t-if="has_reset_program">
                <button class="btn btn-secondary btn-lg py-5" t-att-class="{'disabled': !pos.getOrder().isProgramsResettable()}"
                    t-on-click="() => this.pos.resetPrograms()">
                    <i class="fa fa-star me-1"/>Reset Programs
                </button>
            </t>
        </xpath>
    </t>
</templates>